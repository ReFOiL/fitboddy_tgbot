# Фичи
# false — оплата выключена: CRYPTBOT_* не обязательны, у всех доступ как у PREMIUM (см. PremiumAccess).
FEATURE_PAYMENT_ENABLED=true

# Веб-админка: первый суперпользователь (создаётся при пустой таблице admin_accounts) и JWT.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=12344321qWWs
# Секрет подписи access-токена (длинная случайная строка в проде).
ADMIN_JWT_SECRET=change_me_jwt_secret_min_16_chars
ADMIN_JWT_EXPIRE_MINUTES=480

# Telegram. TELEGRAM_BOT_TOKEN — тот же токен, что у воркера уведомлений plan-service.
# Им бот принимает /start и /link, им же воркер шлёт сообщения о тренировках.
# BOT_TOKEN — прежнее имя. Если заданы оба, значения должны совпадать.
# Пустой TELEGRAM_BOT_TOKEN: используется BOT_TOKEN, оплата и бот не меняются.
TELEGRAM_BOT_TOKEN=change_me
BOT_TOKEN=change_me

# Привязка чата к уведомлениям о тренировках.
# PLAN_SERVICE_URL — происхождение plan-service без пути, например http://plan-service:8000.
# INTERNAL_SERVICE_TOKEN — тот же секрет, что у plan-service (заголовок X-Service-Token).
# Оба пустые: бот работает, /link и /start <код> отвечают, что привязка сейчас недоступна.
PLAN_SERVICE_URL=http://plan-service:8000
INTERNAL_SERVICE_TOKEN=change_me

# Database (docker)
DB_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://fitboddy:change_me@postgres:5432/fitboddy

# Redis (docker)
REDIS_URL=redis://redis:6379/0

# CryptoBot (обязательны только при FEATURE_PAYMENT_ENABLED=true)
CRYPTBOT_API_TOKEN=change_me
CRYPTBOT_WEBHOOK_SECRET=change_me

# MinIO (docker)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change_me
MINIO_ENDPOINT=minio:9000
# Адрес MinIO, с которого открываются ссылки в браузере (админка — просмотр видео). Не задавать = тот же, что MINIO_ENDPOINT.
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_SECURE=false
MINIO_BUCKET=fitboddy

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318/v1/traces
SERVICE_NAME=fitboddy-bot

# Grafana
GRAFANA_PASSWORD=change_me

# PgAdmin
PGADMIN_DEFAULT_EMAIL=admin@fitboddy.local
PGADMIN_DEFAULT_PASSWORD=change_me

